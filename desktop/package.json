{
  "name": "gitwhisper-desktop",
  "productName": "GitWhisper Installer",
  "version": "0.3.0",
  "description": "GitWhisper graphical installer - Conventional Commits + gitmoji, automatically.",
  "main": "main.js",
  "author": "GitWhisper",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.gitwhisper.installer",
    "productName": "GitWhisper Installer",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../gitwhisper.ps1",
        "to": "scripts/gitwhisper.ps1"
      },
      {
        "from": "../gitwhisper.sh",
        "to": "scripts/gitwhisper.sh"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "GitWhisper-Installer-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
